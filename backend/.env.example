# ---- Server ----
PORT=4000
# Where the React app runs (used for CORS in development)
FRONTEND_URL=http://localhost:5173
# Library's local time zone - used to decide "today" for due dates
TIMEZONE=Asia/Kolkata

# ---- Database (local MongoDB, or a free MongoDB Atlas M0 cluster) ----
MONGODB_URI=mongodb://127.0.0.1:27017/digital_library

# ---- Auth ----
# Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login session lasts
JWT_EXPIRES_IN=8h
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# First admin account - created automatically on first start if no users exist.
ADMIN_NAME=Library Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---- Production: serve the built React app from this server (optional) ----
# FRONTEND_DIST=../frontend/dist
